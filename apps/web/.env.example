# Ideaven web app configuration (copy to .env.local and adjust).
# Never commit real secrets — .env files are gitignored.

# Canonical origin of the deployed site. Used for canonical URLs,
# sitemap.xml, robots.txt, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Go API base URL (see apps/api/README.md for API_ADDR and API_ALLOWED_ORIGINS).
# Browser-visible: consumed by src/lib/api.ts for all auth requests.
# NEXT_PUBLIC_API_URL=http://localhost:8080
