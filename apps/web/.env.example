# Ideaven web app configuration (copy to .env.local and adjust).
# Never commit real secrets — .env files are gitignored.

# Canonical origin of the deployed site. Used for canonical URLs,
# sitemap.xml, robots.txt, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Go API base URL consumed by src/lib/api.ts. Leave unset in production: the
# API service is routed behind /api/* on the same domain (see vercel.json),
# so api.ts defaults to same-origin. Local dev points it at the API port.
# NEXT_PUBLIC_API_URL=http://localhost:8081
