# Ideaven API configuration (copy to .env and adjust).
# Never commit real secrets — .env files are gitignored.

# development | production. Production enforces SESSION_SECRET,
# API_ALLOWED_ORIGINS, and Secure cookies.
API_ENV=development

# Listen address.
API_ADDR=:8080

# Comma-separated browser origins allowed to call the API with credentials.
API_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL DSN. In development the API auto-creates the named database
# when missing (local PostgreSQL only).
DATABASE_URL=postgres://ideaven:ideaven@127.0.0.1:5432/ideaven?sslmode=disable

# Hex-encoded HMAC key for session/token verifiers (min 32 bytes).
# Required in production. Generate: openssl rand -hex 32
# In development, when unset, a random key is generated once and persisted
# to apps/api/.data/session_secret (0600, gitignored).
#SESSION_SECRET=

# Frontend origin used to build links inside emails (reset, verification).
APP_URL=http://localhost:3000
